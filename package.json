{
  "name": "linter-todo",
  "author": "lumine-code",
  "description": "Report TODO-style keywords as linter messages.",
  "repository": "https://github.com/lumine-code/linter-todo",
  "bugs": {
    "url": "https://github.com/lumine-code/linter-todo/issues"
  },
  "keywords": [
    "fixme",
    "hack",
    "note",
    "review",
    "bug"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "activationCommands": {
    "atom-workspace": [
      "linter-todo:toggle-state",
      "linter-todo:lint-projects",
      "linter-todo:lint-selected"
    ]
  },
  "consumedServices": {
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "providedServices": {
    "linter.provider": {
      "versions": {
        "1.0.0": "provideLinter"
      }
    }
  },
  "linter-package": true,
  "configSchema": {
    "state": {
      "title": "Linter state",
      "description": "Enable or disable the service of linter.",
      "type": "boolean",
      "default": true
    },
    "excludeVcsIgnoredPaths": {
      "title": "Exclude VCS ignored paths",
      "description": "Skip files your VCS ignores when scanning a project. Turn this off to scan ignored files such as build output or vendored code.",
      "type": "boolean",
      "default": true
    },
    "keywords": {
      "title": "Keywords",
      "description": "List of TODO-style keywords to detect.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "TODO",
        "FIXME",
        "CHANGED",
        "XXX",
        "IDEA",
        "HACK",
        "NOTE",
        "REVIEW",
        "NB",
        "BUG",
        "QUESTION",
        "COMBAK",
        "TEMP",
        "DEBUG",
        "OPTIMIZE",
        "WARNING"
      ]
    }
  },
  "dependencies": {
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
